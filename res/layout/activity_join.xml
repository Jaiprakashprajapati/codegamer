<?xml version="1.0" encoding="utf-8"?>
<!-- JOIN SCREEN -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_game_gradient">

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="background"
        android:scaleType="centerCrop"
        android:src="@drawable/bg_stars" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingTop="12dp"
            android:paddingBottom="12dp">

            <include layout="@layout/view_logo" />

            <EditText
                android:id="@+id/etRoomId"
                android:layout_width="300dp"
                android:layout_height="54dp"
                android:layout_marginTop="14dp"
                android:background="@drawable/px_input"
                android:digits="0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz."
                android:fontFamily="@font/press_start_2p"
                android:gravity="center"
                android:hint="ENTER ROOM ID"
                android:imeOptions="actionDone"
                android:includeFontPadding="false"
                android:inputType="textCapCharacters"
                android:maxLength="15"
                android:singleLine="true"
                android:textColor="#FFFFFF"
                android:textColorHint="#6E6AA8"
                android:textSize="11sp"
                app:fontFamily="@font/press_start_2p" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnJoin"
                style="@style/PixelButton"
                android:layout_width="200dp"
                android:layout_height="54dp"
                android:layout_marginTop="14dp"
                android:background="@drawable/px_btn_pink"
                android:text="JOIN ROOM" />

            <TextView
                android:id="@+id/tvStatus"
                style="@style/PixelText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center"
                android:text=""
                android:textColor="#B9B4FF"
                android:textSize="7sp" />
        </LinearLayout>
    </ScrollView>
</FrameLayout>
