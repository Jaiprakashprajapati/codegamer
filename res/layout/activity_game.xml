<?xml version="1.0" encoding="utf-8"?>
<!-- 1v1 FIRST PERSON SNIPER DUEL GAMEPLAY SCREEN -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0A061E">

    <!-- 60 FPS Hardware-Accelerated 3D-Perspective Sniper Arena SurfaceView -->
    <com.example.snipe.SniperGameView
        android:id="@+id/gameView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- TOP HUD: Scoreboard & Target Kills -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="14dp"
        android:paddingTop="12dp"
        android:paddingEnd="14dp">

        <TextView
            android:id="@+id/tvPlayerScore"
            style="@style/PixelText"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:layout_alignParentStart="true"
            android:background="@drawable/px_card_blue"
            android:gravity="center"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingBottom="4dp"
            android:text="YOU: 0"
            android:textSize="9sp" />

        <TextView
            android:id="@+id/tvGoal"
            style="@style/PixelText"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:layout_centerHorizontal="true"
            android:background="@drawable/px_card_purple"
            android:gravity="center"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:paddingBottom="4dp"
            android:text="FIRST TO 5 KILLS"
            android:textColor="#FFE14D"
            android:textSize="8sp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvEnemyScore"
                style="@style/PixelText"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:background="@drawable/px_card_red"
                android:gravity="center"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingBottom="4dp"
                android:text="ENEMY: 0"
                android:textSize="9sp" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnExit"
                style="@style/PixelButton"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/px_btn_pink"
                android:text="X"
                android:textSize="10sp" />
        </LinearLayout>
    </RelativeLayout>

    <!-- BOTTOM-LEFT: Defensive Cover & Peeking Controls -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|start"
        android:layout_marginStart="14dp"
        android:layout_marginBottom="14dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvStance"
            style="@style/PixelText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:text="STANCE: STANDING"
            android:textColor="#29D3F5"
            android:textSize="7sp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnPeekLeft"
                style="@style/PixelButton"
                android:layout_width="68dp"
                android:layout_height="48dp"
                android:background="@drawable/px_btn_amber"
                android:text="&lt; PEEK"
                android:textSize="8sp" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnDuck"
                style="@style/PixelButton"
                android:layout_width="96dp"
                android:layout_height="48dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/px_btn_green"
                android:text="DUCK"
                android:textSize="9sp" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnPeekRight"
                style="@style/PixelButton"
                android:layout_width="68dp"
                android:layout_height="48dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/px_btn_amber"
                android:text="PEEK &gt;"
                android:textSize="8sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- BOTTOM-RIGHT: Offense, Scope & Fire Controls -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="14dp"
        android:layout_marginBottom="14dp"
        android:gravity="bottom"
        android:orientation="horizontal">

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnSteady"
            style="@style/PixelButton"
            android:layout_width="80dp"
            android:layout_height="48dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/px_btn_pink"
            android:text="STEADY"
            android:textSize="8sp"
            android:visibility="gone" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnScope"
            style="@style/PixelButton"
            android:layout_width="88dp"
            android:layout_height="52dp"
            android:background="@drawable/px_btn_cyan"
            android:text="SCOPE"
            android:textSize="9sp" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnFire"
            style="@style/PixelButton"
            android:layout_width="104dp"
            android:layout_height="58dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/px_btn_red"
            android:text="FIRE"
            android:textColor="#FFFFFF"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- MATCH OVER CONTROLS (Appears on Victory or Defeat) -->
    <LinearLayout
        android:id="@+id/matchOverPanel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginTop="90dp"
        android:orientation="horizontal"
        android:visibility="gone">

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnRematch"
            style="@style/PixelButton"
            android:layout_width="140dp"
            android:layout_height="50dp"
            android:background="@drawable/px_btn_green"
            android:text="REMATCH"
            android:textSize="9sp" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnLeave"
            style="@style/PixelButton"
            android:layout_width="140dp"
            android:layout_height="50dp"
            android:layout_marginStart="14dp"
            android:background="@drawable/px_btn_pink"
            android:text="EXIT ROOM"
            android:textSize="9sp" />
    </LinearLayout>
</FrameLayout>
