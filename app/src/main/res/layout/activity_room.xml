<?xml version="1.0" encoding="utf-8"?>
<!-- ROOM SCREEN (used by both host and guest) -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_game_gradient">

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="background"
        android:scaleType="centerCrop"
        android:src="@drawable/bg_stars" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingTop="12dp"
            android:paddingBottom="12dp">

            <include layout="@layout/view_logo" />

            <!-- Player slots -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvP1"
                    style="@style/PixelText"
                    android:layout_width="170dp"
                    android:layout_height="50dp"
                    android:background="@drawable/px_card_blue"
                    android:gravity="center"
                    android:paddingBottom="5dp"
                    android:text="PLAYER 1"
                    android:textSize="10sp" />

                <TextView
                    style="@style/PixelText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="16dp"
                    android:shadowColor="#000000"
                    android:shadowDx="2"
                    android:shadowDy="2"
                    android:shadowRadius="1"
                    android:text="VS"
                    android:textColor="#FFE14D"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/tvP2"
                    style="@style/PixelText"
                    android:layout_width="170dp"
                    android:layout_height="50dp"
                    android:background="@drawable/px_card_grey"
                    android:gravity="center"
                    android:paddingBottom="5dp"
                    android:text="PLAYER 2"
                    android:textSize="10sp" />
            </LinearLayout>

            <!-- Kills selector -->
            <RadioGroup
                android:id="@+id/rgKills"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/px_card_dark"
                android:orientation="horizontal"
                android:paddingStart="8dp"
                android:paddingTop="8dp"
                android:paddingEnd="8dp"
                android:paddingBottom="12dp">

                <RadioButton
                    android:id="@+id/rb3"
                    style="@style/PixelText"
                    android:layout_width="104dp"
                    android:layout_height="40dp"
                    android:layout_margin="3dp"
                    android:background="@drawable/px_chip"
                    android:button="@null"
                    android:checked="true"
                    android:gravity="center"
                    android:paddingBottom="3dp"
                    android:text="3 KILLS"
                    android:textColor="@color/chip_text"
                    android:textSize="9sp" />

                <RadioButton
                    android:id="@+id/rb5"
                    style="@style/PixelText"
                    android:layout_width="104dp"
                    android:layout_height="40dp"
                    android:layout_margin="3dp"
                    android:background="@drawable/px_chip"
                    android:button="@null"
                    android:gravity="center"
                    android:paddingBottom="3dp"
                    android:text="5 KILLS"
                    android:textColor="@color/chip_text"
                    android:textSize="9sp" />

                <RadioButton
                    android:id="@+id/rb10"
                    style="@style/PixelText"
                    android:layout_width="104dp"
                    android:layout_height="40dp"
                    android:layout_margin="3dp"
                    android:background="@drawable/px_chip"
                    android:button="@null"
                    android:gravity="center"
                    android:paddingBottom="3dp"
                    android:text="10 KILLS"
                    android:textColor="@color/chip_text"
                    android:textSize="9sp" />
            </RadioGroup>

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnStart"
                style="@style/PixelButton"
                android:layout_width="200dp"
                android:layout_height="54dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/px_btn_green"
                android:text="START" />

            <TextView
                android:id="@+id/tvHint"
                style="@style/PixelText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center"
                android:text=""
                android:textColor="#B9B4FF"
                android:textSize="7sp" />
        </LinearLayout>
    </ScrollView>

    <!-- Room ID badge (top-right) -->
    <TextView
        android:id="@+id/tvRoomId"
        style="@style/PixelText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_margin="14dp"
        android:background="@drawable/px_card_purple"
        android:paddingStart="14dp"
        android:paddingTop="10dp"
        android:paddingEnd="14dp"
        android:paddingBottom="15dp"
        android:text="ROOM ID: ------"
        android:textSize="9sp" />
</FrameLayout>
